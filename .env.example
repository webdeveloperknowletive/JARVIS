# JARVIS CRM Production Environment Configuration
PROJECT_NAME="JARVIS CRM"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Database
DATABASE_URL=postgresql://jarvis_user:CHANGE_ME_URL_ENCODED@localhost:5432/jarvis_crm

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://red-dan1slbtqb8s73a9h690:6379

# Security (Generate secure random key with openssl rand -hex 32)
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173", "https://your-frontend.vercel.app"]

# Frontend URLs
# VITE_API_BASE_URL=https://jarvis-crm-01.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Storage
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./storage_uploads
MAX_UPLOAD_SIZE_MB=50

# Telephony & Messaging Stubs (Twilio, Exotel, Gupshup, WhatsApp Business API)
TELEPHONY_PROVIDER=MOCK
WHATSAPP_PROVIDER=MOCK
EMAIL_PROVIDER=SMTP
